# =========================
# TELEGRAM
# =========================
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=AscentPrivate_bot
TELEGRAM_CHANNEL_ID=-1003869201155
TELEGRAM_SUPPORT_CHAT_ID=-1004441348826
BOT_ADMIN_IDS=

# =========================
# SUBSCRIPTION
# =========================
SUBSCRIPTION_RUB_PRICE=8000
SUBSCRIPTION_DAYS=30
TRIAL_DAYS=30
ALLOW_REPEAT_TRIAL_FOR_TESTING=false
CURRENCY_CODE=RUB

# =========================
# SITE
# =========================
SITE_URL=https://ascentprivate.com
PAYMENT_FORM_LOCATION=SITE_FOOTER
PAYMENT_FORM_ANCHOR=#payment
PAYMENT_PAGE_URL=https://ascentprivate.com/#payment
PAYMENT_SUCCESS_URL=https://ascentprivate.com/?payment=success#payment
PAYMENT_FAIL_URL=https://ascentprivate.com/?payment=fail#payment
BOT_TRIAL_START_PARAM=trial_site
BOT_PAYMENT_START_PARAM=pay_site
BOT_FAQ_START_PARAM=faq_site

# =========================
# ROBOKASSA
# =========================
PAYMENT_PROVIDER=YOOKASSA
PAYMENT_ENTRYPOINT=WEBSITE_FOOTER_FORM_DYNAMIC
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_TEST_PASSWORD1=
ROBOKASSA_TEST_PASSWORD2=
ROBOKASSA_IS_TEST=0
ROBOKASSA_HASH_ALGORITHM=MD5
ROBOKASSA_PAYMENT_URL=https://auth.robokassa.ru/Merchant/Index.aspx
ROBOKASSA_PAYMENT_DESCRIPTION=Подписка Ascent Private на 30 дней
ROBOKASSA_RESULT_URL=https://bot.ascentprivate.com/robokassa/result
ROBOKASSA_SUCCESS_URL=https://bot.ascentprivate.com/robokassa/success
ROBOKASSA_FAIL_URL=https://bot.ascentprivate.com/robokassa/fail
ROBOKASSA_USE_IFRAME=true
ROBOKASSA_IFRAME_MODE=modal
ROBOKASSA_USE_SHP_PARAMS=true
ROBOKASSA_SHP_USER_PARAM=Shp_telegram_user_id
ROBOKASSA_SHP_PAYMENT_PARAM=Shp_payment_id
ROBOKASSA_SHP_TOKEN_PARAM=Shp_payment_token

# =========================
# YOOKASSA
# Active provider for new payments.
# =========================
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_URL=https://api.yookassa.ru/v3
YOOKASSA_RETURN_URL=https://ascentprivate.com/?payment=success#payment
YOOKASSA_PAYMENT_DESCRIPTION=Подписка Ascent Private на 30 дней
YOOKASSA_CAPTURE=true
YOOKASSA_RECEIPT_ENABLED=true
YOOKASSA_VAT_CODE=1
YOOKASSA_PAYMENT_MODE=full_payment
YOOKASSA_PAYMENT_SUBJECT=service
YOOKASSA_WEBHOOK_URL=https://bot.ascentprivate.com/yookassa/webhook

# =========================
# DATABASE
# =========================
POSTGRES_DB=ascent_private_bot
POSTGRES_USER=ascent_bot_user
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://ascent_bot_user:CHANGE_ME@postgres:5432/ascent_private_bot

# =========================
# REDIS
# =========================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# =========================
# ANALYTICS / YANDEX
# =========================
# First-party events are collected at POST /api/events and do not require a secret.
YANDEX_METRIKA_COUNTER_ID=
YANDEX_METRIKA_OFFLINE_CONVERSION_TARGET=payment_confirmed
YANDEX_METRIKA_OFFLINE_CONVERSION_ID_TYPE=CLIENT_ID
YANDEX_METRIKA_API_BASE_URL=https://api-metrika.yandex.net
YANDEX_DIRECT_CLIENT_LOGIN=
YANDEX_DIRECT_OAUTH_TOKEN=
YANDEX_DIRECT_API_BASE_URL=https://api.direct.yandex.com
YANDEX_DIRECT_REPORTS_API_URL=https://api.direct.yandex.com/json/v501/reports
YANDEX_DIRECT_SANDBOX=false
YANDEX_DIRECT_USE_OPERATOR_UNITS=false
YANDEX_METRIKA_OAUTH_TOKEN=

# =========================
# CODEX / OPENAI DECISIONS
# =========================
OPENAI_API_KEY=
OPENAI_DECISION_MODEL=gpt-5-codex
OPENAI_DECISION_TIMEOUT_SECONDS=60
OPENAI_DECISION_DRY_RUN=true
MARKETING_AUTOMATION_MODE=read_only
CODEX_EXECUTOR_WRITE_ENABLED=false
MARKETING_APPROVED_DAILY_BUDGET=0
MARKETING_BID_CHANGE_CYCLE_MAX_PERCENT=15
MARKETING_BUDGET_CHANGE_DAY_MAX_PERCENT=20
MARKETING_MIN_KEYWORD_CLICKS=50
MARKETING_MIN_AD_GROUP_CLICKS=100
MARKETING_DECISION_CONFIDENCE_MIN=0.70
MARKETING_MAX_ACTIONS_PER_DAY=1

# =========================
# EMAIL / SMTP
# =========================
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=ascentprivate@gmail.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=ascentprivate@gmail.com
SMTP_FROM_NAME=Ascent Private
SMTP_USE_TLS=true
AUTH_CONFIRMATION_TOKEN_TTL_HOURS=24
AUTH_RESET_TOKEN_TTL_HOURS=24
AUTH_SESSION_TTL_DAYS=14
AUTH_SESSION_COOKIE_NAME=ascent_cabinet_session
AUTH_PUBLIC_API_URL=https://bot.ascentprivate.com
AUTH_DEV_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5176,http://localhost:5176
PAYMENT_REPORT_EMAIL_ENABLED=true
PAYMENT_REPORT_EMAIL_TO=admin@ascentprivate.com
PAYMENT_REPORT_EMAIL_SUBJECT=Новая оплата Ascent Private
# Web App URL мастер-таблицы Ascent Private Client Funnel: оплаты YooKassa, платежная форма и FAQ.
PAYMENT_REPORT_SHEETS_ENDPOINT=
TRIAL_REPORT_SHEETS_ENDPOINT=

# =========================
# WEBHOOKS / SERVER
# =========================
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
DOMAIN=bot.ascentprivate.com
TELEGRAM_WEBHOOK_URL=https://bot.ascentprivate.com/telegram/webhook
ROBOKASSA_WEBHOOK_URL=https://bot.ascentprivate.com/robokassa/result
TELEGRAM_WEBHOOK_SECRET=
SECRET_KEY=
PAYMENT_TOKEN_TTL_MINUTES=60
LOG_LEVEL=INFO
